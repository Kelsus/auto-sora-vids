{
  "info": {
    "_postman_id": "a4dbd267-4d0b-4f84-9a1d-78d093e7e0dd",
    "name": "Video Automation API",
    "description": "Collection to exercise the serverless video automation endpoints deployed via `VideoAutomationStack`.\n\nEnvironment variable `api_base_url` should point at the API Gateway stage endpoint (e.g. `https://uxc155vpv4.execute-api.us-east-1.amazonaws.com/prod`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Submit Video Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/news/investigative-piece\",\n  \"scheduled_datetime\": \"2025-10-17T21:30:00Z\",\n  \"metadata\": {\n    \"notes\": \"Submitted from Postman\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api_base_url}}/jobs",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "jobs"
          ]
        },
        "description": "Creates (or upserts) a video automation job. The job ID is derived from the article URL slug."
      },
      "response": []
    },
    {
      "name": "List Jobs (Paginated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_base_url}}/jobs?limit=10",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "jobs"
          ],
          "query": [
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "cursor",
              "value": "",
              "description": "Optional pagination cursor returned as `nextCursor` from the previous call."
            }
          ]
        },
        "description": "Retrieves a paginated list of jobs. Supply the optional `cursor` query parameter with the `nextCursor` value from a previous response to fetch the next page."
      },
      "response": []
    },
    {
      "name": "Get Job By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_base_url}}/jobs/{{job_id}}",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "jobs",
            "{{job_id}}"
          ]
        },
        "description": "Fetches a single job by its `jobId`. The identifier is typically the slugified article URL returned when a job is created."
      },
      "response": []
    },
    {
      "name": "Patch Job",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RUNNING\",\n  \"job_type\": \"IMMEDIATE\",\n  \"pipeline_config\": {\n    \"drive_folder\": \"Editorial\"\n  },\n  \"scheduled_datetime\": \"2025-10-18T10:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{api_base_url}}/jobs/{{job_id}}",
          "host": [
            "{{api_base_url}}"
          ],
          "path": [
            "jobs",
            "{{job_id}}"
          ]
        },
        "description": "Updates allowed fields (`status`, `job_type`, `pipeline_config`, `scheduled_datetime`) for an existing job. Omit fields you do not wish to change."
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": []
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"HTTP 201 Created\", function () {",
          "    pm.response.to.have.status(201);",
          "});",
          "",
          "pm.test(\"Response contains jobId\", function () {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('jobId');",
          "    pm.expect(jsonData.jobId).to.be.a('string').and.not.empty;",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "api_base_url",
      "value": "https://uxc155vpv4.execute-api.us-east-1.amazonaws.com/prod",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    }
  ]
}
